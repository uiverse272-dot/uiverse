# The canonical origin for metadata, the sitemap and share images, no trailing slash.
# On Vercel the production domain is used when this is unset; otherwise it falls back to localhost.
NEXT_PUBLIC_SITE_URL=

# Capture screenshots in object storage. Leave NEXT_PUBLIC_CAPTURES_URL unset to serve them
# from public/captures, as in local development.

# The bucket's public URL, no trailing slash — e.g. https://pub-xxxx.r2.dev or a custom domain.
# Read at build time: changing it needs a rebuild.
NEXT_PUBLIC_CAPTURES_URL=

# Only `npm run capture:upload` reads these; the app never does.
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, region auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
