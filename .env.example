# The canonical origin for metadata, the sitemap and share images, no trailing slash.
# On Vercel the production domain is used when this is unset; otherwise it falls back to localhost.
NEXT_PUBLIC_SITE_URL=

# Capture screenshots in object storage. Leave NEXT_PUBLIC_CAPTURES_URL unset to serve them
# from public/captures, as in local development.

# The bucket's public URL, no trailing slash — e.g. https://pub-xxxx.r2.dev or a custom domain.
# Read at build time: changing it needs a rebuild.
NEXT_PUBLIC_CAPTURES_URL=

# Only `npm run capture:upload` reads these; the app never does.
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, region auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Takedown requests (/legal/takedown) go to a webhook, an email, or both. In development with
# neither set they're saved to .takedowns/requests.jsonl; in production the form refuses rather
# than lose a request.
TAKEDOWN_WEBHOOK_URL=
RESEND_API_KEY=
TAKEDOWN_EMAIL_TO=
TAKEDOWN_EMAIL_FROM=

# Accounts (Better Auth) and saves. Supabase: Project settings → Database → connection string.
# Use the transaction pooler URL here; run `npm run db:migrate` with the session/direct URL.
# Unset outside production, accounts run on an embedded Postgres in .data.nosync/ (outside iCloud sync) — nothing to sign up for.
DATABASE_URL=
# openssl rand -base64 32 — required in production, or accounts stay off
BETTER_AUTH_SECRET=
# the public origin, if it differs from NEXT_PUBLIC_SITE_URL
BETTER_AUTH_URL=
# sign-in links by email (Resend; RESEND_API_KEY above). Without them, in development the link
# is printed to the server log; in production email sign-in is off.
AUTH_EMAIL_FROM=
# OAuth apps — callback URL: <origin>/api/auth/callback/google (or /github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
