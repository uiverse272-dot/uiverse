{
  "name": "uiverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "capture": "node scripts/capture/capture.mjs",
    "capture:upload": "node --env-file-if-exists=.env.local scripts/capture/upload.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "next": "^16.4.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
