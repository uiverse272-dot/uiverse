{
  "name": "uiverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "capture": "node scripts/capture/capture.mjs",
    "capture:cards": "tsx scripts/capture/cards.mts",
    "craft:posters": "tsx scripts/craft-posters.mts",
    "finds:add": "tsx scripts/finds-add.mts",
    "capture:upload": "node --env-file-if-exists=.env.local scripts/capture/upload.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "db:generate": "drizzle-kit generate",
    "check:env": "tsx scripts/check-env.mts",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
