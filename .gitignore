# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# real folders behind the symlinks — the .nosync suffix keeps iCloud from evicting them
/node_modules.nosync
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next
/.next.nosync
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw capture measurements (re-derivable, large)
/.captures-raw

# local reference images
/Inspos

# Finder / iCloud sync duplicates ("page 2.tsx")
* 2.*
